# ---- Server-side only. Never prefix these with NEXT_PUBLIC_. ----

# NVIDIA NIM (free) — used for BOTH embeddings and chat. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=

# Embedding model id as listed by GET https://integrate.api.nvidia.com/v1/models
# Must be identical at ingest time and query time (re-run `npm run ingest` if you change it).
# nemotron-3-embed-1b returns fixed 2048-dim vectors (it rejects a `dimensions` override).
EMBED_MODEL=nvidia/nemotron-3-embed-1b
EMBED_DIMENSIONS=

# Chat models tried in order on NVIDIA NIM. A model that just failed is tried last; there is a 32 s total budget per
# question. Availability changes — the llama-3.x models were retired 2026-08-26 — so test with a real request.
# Reasoning models are called with thinking switched off (see PROFILES in src/lib/rag/config.ts).
CHAT_MODELS=mistralai/mistral-nemotron,nvidia/nemotron-3-ultra-550b-a55b,z-ai/glm-5.3-flash,moonshotai/kimi-k3,nvidia/nemotron-3.5-lightning-30b-a3b
# Optional dedicated key per model (each falls back to NVIDIA_API_KEY if empty):
NVIDIA_API_KEY_ULTRA=
NVIDIA_API_KEY_GLM=
NVIDIA_API_KEY_KIMI=
NVIDIA_API_KEY_LIGHTNING=

# Reserve LLM providers (free tiers) — tried ONLY after the NVIDIA models above have failed, in this order, once each,
# and capped per hour per server instance so their small quotas last. `npm run eval` / `npm run ask` leave them off
# unless you pass --reserve. Each is skipped if its key is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
# must end in ":free" — anything else is ignored so a free key can never spend credits
OPENROUTER_MODEL=google/gemma-4-31b-it:free
SITE_URL=
USE_RESERVE_LLMS=1
RESERVE_MAX_PER_HOUR=20
# Any other OpenAI-compatible provider (e.g. Groq: https://api.groq.com/openai/v1) can be added as one more reserve:
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Supabase (free) pgvector store. If unset, the app falls back to data/index.json.
# Runtime search uses SUPABASE_URL + SUPABASE_KEY (the publishable/anon key is enough: it can only call match_chunks).
SUPABASE_URL=
SUPABASE_KEY=
# Ingestion only (local, never set on Vercel): direct Postgres connection, URL-encode special characters in the password.
DATABASE_URL=

# Retrieval tuning
TOP_K=10
# Cosine-similarity floor. If the best chunk scores below this, the question is treated as
# out-of-scope and refused without calling the LLM. Calibrate with `npm run eval -- --retrieval-only`.
MIN_RELEVANCE=0.15

# ---- Public (safe to expose): only shown on the page if you set them. ----
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
